{
  "name": "@ai-novel/new-design",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    }
  },
  "files": [
    "dist",
    "docs",
    "migrations",
    "runtime",
    "scripts",
    "src/client",
    "src/common"
  ],
  "scripts": {
    "build": "npm run build:server && npm run typecheck:client && npm run build:client",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "npm run build:server && npm run typecheck:client",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "runtime:assemble": "node scripts/assemble-runtime.cjs",
    "runtime:cli": "node dist/server/runtime/cli.js",
    "dev": "tsx src/server/app/development.ts",
    "dev:server": "tsx watch src/server/app/main.ts",
    "dev:client": "vite",
    "dev:compare": "node scripts/comparison/gateway.mjs",
    "start": "node dist/server/app/main.js",
    "check:boundary": "node --test tests/standalone-boundary.test.cjs",
    "test": "pnpm run build:server && node --test tests/unit.test.cjs tests/form-ai.unit.test.cjs tests/presentation.unit.test.cjs tests/client-entry.unit.test.cjs",
    "test:form-ai": "pnpm run build:server && node --test tests/form-ai.postgres.test.cjs tests/form-ai.live-model.test.cjs",
    "test:research-adoption": "pnpm run build:server && node --test tests/research-adoption.postgres.test.cjs",
    "test:context-author": "pnpm run build:server && node --test tests/context-author.unit.test.cjs tests/context-author.postgres.test.cjs",
    "test:form-ai-blank": "pnpm run build:server && node --test tests/form-ai.unit.test.cjs tests/form-ai-blank.postgres.test.cjs tests/form-ai.postgres.test.cjs",
    "test:creation-director": "pnpm run build:server && node --test tests/unit.test.cjs tests/creation-director.postgres.test.cjs",
    "test:integration": "pnpm run build:server && node --test tests/postgres.integration.test.cjs"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@embedded-postgres/windows-x64": "17.6.0-beta.15",
    "express": "^5.2.1",
    "pg": "8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.20.6",
    "vite": "^7.3.1",
    "typescript": "^5.9.3"
  }
}
