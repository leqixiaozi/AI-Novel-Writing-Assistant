# Copy to .env and set the password, or generate .env with:
# node scripts/initialize-development.cjs --initialize-new
# Existing runtime.json: node scripts/initialize-development.cjs --import-runtime-json
# Configure storage before the first database start; changing a path does not migrate data.
NEW_DESIGN_DEV_DB_PORT=15433
NEW_DESIGN_DEV_DB_BIND_ADDRESS=127.0.0.1
NEW_DESIGN_DEV_DB_DATA_SOURCE=new-design-postgres-data
# Windows host-directory example:
# NEW_DESIGN_DEV_DB_DATA_SOURCE=D:/infra/data/ai-novel-new-design/postgres17
# Explicit external access: NEW_DESIGN_DEV_DB_BIND_ADDRESS=0.0.0.0
NEW_DESIGN_DEV_DB_USER=new_design
NEW_DESIGN_DEV_DB_NAME=new_design
# Use a strong password; single-quote values containing $ or #.
NEW_DESIGN_DEV_DB_PASSWORD=
