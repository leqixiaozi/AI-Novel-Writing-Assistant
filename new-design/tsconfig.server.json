{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "types": ["node"],
    "noEmit": false
  },
  "include": ["src/common/**/*.ts", "src/server/**/*.ts"],
  "exclude": ["dist", "node_modules", "src/client"]
}
